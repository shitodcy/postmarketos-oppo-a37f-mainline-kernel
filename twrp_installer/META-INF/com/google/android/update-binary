#!/sbin/sh

OUTFD=$2
ZIPFILE=$3

ui_print() {
  echo -e "ui_print $1\nui_print" > /proc/self/fd/$OUTFD
}

ui_print "****************************************"
ui_print " OPPO A37f (MSM8916) postmarketOS Setup "
ui_print "****************************************"
ui_print ""
ui_print "- Extracting files..."
mkdir -p /tmp/pmos_install
unzip -o "$ZIPFILE" -d /tmp/pmos_install > /dev/null

ui_print "- Flashing lk2nd to boot partition..."
dd if=/tmp/pmos_install/lk2nd.img of=/dev/block/bootdevice/by-name/boot bs=4096

ui_print "- Formatting system partition (pmOS_boot) to ext2..."
umount /dev/block/bootdevice/by-name/system 2>/dev/null
mke2fs -t ext2 -L pmOS_boot /dev/block/bootdevice/by-name/system

ui_print "- Installing kernel, initramfs, and dtb..."
mkdir -p /tmp/pmos_boot_mnt
mount -t ext2 /dev/block/bootdevice/by-name/system /tmp/pmos_boot_mnt
cp -r /tmp/pmos_install/pmos_boot/* /tmp/pmos_boot_mnt/

ui_print "- Updating extlinux.conf UUIDs..."
# Ambil UUID dari partisi yang baru diformat
BOOT_UUID=$(blkid /dev/block/bootdevice/by-name/system | grep -o 'UUID="[^"]*"' | cut -d'"' -f2)
ROOT_UUID=$(blkid /dev/block/bootdevice/by-name/userdata | grep -o 'UUID="[^"]*"' | cut -d'"' -f2)

if [ -n "$BOOT_UUID" ] && [ -n "$ROOT_UUID" ]; then
    sed -i "s/pmos_boot_uuid=[^ ]*/pmos_boot_uuid=$BOOT_UUID/g" /tmp/pmos_boot_mnt/extlinux/extlinux.conf
    sed -i "s/pmos_root_uuid=[^ ]*/pmos_root_uuid=$ROOT_UUID/g" /tmp/pmos_boot_mnt/extlinux/extlinux.conf
    ui_print "  -> Boot UUID: $BOOT_UUID"
    ui_print "  -> Root UUID: $ROOT_UUID"
else
    ui_print "  ! Warning: Could not detect UUIDs. Using defaults."
fi

umount /tmp/pmos_boot_mnt
rm -rf /tmp/pmos_install /tmp/pmos_boot_mnt

ui_print ""
ui_print "****************************************"
ui_print " Install Complete!                      "
ui_print " Please format 'userdata' as ext4 and   "
ui_print " flash pmOS_root.img to it if not done. "
ui_print "****************************************"
exit 0
