maintainer="Azunya <azunya@example.com>"
pkgname=device-oppo-a37f
pkgdesc="Oppo A37 (A37f)"
pkgver=1
pkgrel=11
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-msm8916
	postmarketos-base
	postmarketos-zram
	soc-qcom-msm8916
	soc-qcom-msm8916-rproc
	qrtr
	pd-mapper
	tqftpserv
	linux-firmware-qcom
	firmware-oppo-a37f
	msm-firmware-loader
	alsa-ucm-conf
	hwdata
	openssh
	neofetch
	htop
	wlr-randr
	plymouth
	plymouth-drm
	plymouth-openrc-plugin
	postmarketos-plymouth-themes
"
makedepends="devicepkg-dev"
source="
	audio.conf
	usb-gadget
	setup-usb-gadget.sh
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	mac.conf
	90-touchscreen.rules
	90-bq24190-battery.rules
	hide-bq24190.sh
	99-touchscreen-crop.hwdb
	99-usb-network.sh
	60-sensor.hwdb
	wpa_supplicant.conf
	disable-pmf.conf
	dhcp.conf
	90-backlight.rules
	phoc.ini
	phoc-scale.desktop
	machine-info
	99-zram.conf
	wcn36xx.conf
	70-wifi-mac.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/audio.conf \
		"$pkgdir"/etc/modules-load.d/audio.conf
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.virt.d
	install -Dm644 "$srcdir"/mac.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/mac.conf
	install -Dm644 "$srcdir"/disable-pmf.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/disable-pmf.conf
	install -Dm644 "$srcdir"/dhcp.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/dhcp.conf
	install -Dm644 "$srcdir"/phoc.ini \
		"$pkgdir"/etc/phosh/phoc.ini
	install -Dm644 "$srcdir"/phoc-scale.desktop \
		"$pkgdir"/etc/xdg/autostart/phoc-scale.desktop
	install -Dm644 "$srcdir"/machine-info \
		"$pkgdir"/etc/machine-info
	install -Dm644 "$srcdir"/wpa_supplicant.conf \
		"$pkgdir"/etc/wpa_supplicant/wpa_supplicant.conf
	install -Dm644 "$srcdir"/90-touchscreen.rules \
		"$pkgdir"/etc/udev/rules.d/90-touchscreen.rules
	install -Dm644 "$srcdir"/60-sensor.hwdb \
		"$pkgdir"/etc/udev/hwdb.d/60-sensor.hwdb
	install -Dm644 "$srcdir"/90-backlight.rules \
		"$pkgdir"/etc/udev/rules.d/90-backlight.rules
	install -Dm644 "$srcdir"/90-bq24190-battery.rules \
		"$pkgdir"/etc/udev/rules.d/90-bq24190-battery.rules
	install -Dm755 "$srcdir"/hide-bq24190.sh \
		"$pkgdir"/usr/sbin/hide-bq24190.sh
	install -Dm644 "$srcdir"/99-touchscreen-crop.hwdb \
		"$pkgdir"/etc/udev/hwdb.d/99-touchscreen-crop.hwdb
	install -Dm644 "$srcdir"/99-usb-network.sh \
		"$pkgdir"/etc/NetworkManager/dispatcher.d/99-usb-network.sh
	install -Dm644 "$srcdir"/99-zram.conf \
		"$pkgdir"/etc/sysctl.d/99-zram.conf
	install -Dm644 "$srcdir"/wcn36xx.conf \
		"$pkgdir"/etc/modprobe.d/wcn36xx.conf
	install -Dm644 "$srcdir"/70-wifi-mac.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/70-wifi-mac.conf
	install -Dm755 "$srcdir"/usb-gadget \
		"$pkgdir"/etc/init.d/usb-gadget
	install -Dm755 "$srcdir"/setup-usb-gadget.sh \
		"$pkgdir"/usr/bin/setup-usb-gadget.sh
}
