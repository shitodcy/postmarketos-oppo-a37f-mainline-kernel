# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Azunya <azunya@example.com>
maintainer="Azunya <azunya@example.com>"
pkgname=device-oppo-a37f
pkgdesc="Oppo A37 (A37f)"
pkgver=1
pkgrel=5
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
install="$pkgname.post-install"
depends="
	linux-postmarketos-qcom-msm8916
	postmarketos-base
	soc-qcom-msm8916
	openssh
	neofetch
	linux-firmware-qcom
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	usb-network-fix.initd
	disable-random-mac.conf
"
subpackages="$pkgname-kernel-lk2nd:kernel_lk2nd"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir"/usb-network-fix.initd "$pkgdir"/etc/init.d/usb-network-fix
	install -Dm644 "$srcdir"/disable-random-mac.conf "$pkgdir"/etc/NetworkManager/conf.d/disable-random-mac.conf
}

kernel_lk2nd() {
	pkgdesc="Boot via lk2nd using extlinux.conf (appended DTB)"
	# Flash lk2nd via TWRP:
	#   TWRP > Install > Install Image > lk2nd-a37f-adtb.img > Boot partition
	# lk2nd image: https://github.com/rigaz29/android_build_oppo_A37-mainline/releases
	# lk2nd built with: LK2ND_ADTBS="msm8916-mtp.dtb" LK2ND_QCDTBS=
	# board-id: <8 0 15399> (three-cell, must use appended DTB not QCDT)
	depends="linux-postmarketos-qcom-msm8916"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

